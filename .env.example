# Copiez ce fichier en `.env` et renseignez au moins une cle.
# Les embeddings sont calcules en local par defaut : aucune cle n'est
# necessaire pour l'indexation et la recherche.

# --- Offres gratuites (sans carte bancaire) ---
# Groq : https://console.groq.com/keys  (gpt-oss-120b, gpt-oss-20b, qwen3.8-27b)
GROQ_API_KEY=
# Google AI Studio : https://aistudio.google.com/apikey  (Gemma 4, juge du benchmark)
GEMINI_API_KEY=

# --- Configuration d'origine du projet (payante) ---
# OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<ressource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_AI_INFERENCE_ENDPOINT=https://<ressource>.services.ai.azure.com/models
